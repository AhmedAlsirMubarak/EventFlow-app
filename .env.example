APP_NAME=EventFlow
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=eventflow_app
DB_USERNAME=eventflow
DB_PASSWORD=
# Only needed when pg_dump isn't already on PATH (e.g. a bundled/non-standard local
# Postgres install) — required for `backup:run` to actually dump the database. A
# normal VPS with the OS's postgresql-client package installed shouldn't need this.
# PG_DUMP_BINARY_PATH=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Set to true in production (HTTPS) so the session cookie is never sent over plain HTTP.
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Microsoft 365 / Outlook SMTP (STARTTLS on port 587). Requires SMTP AUTH
# enabled on the mailbox (tenant admin setting) and, if MFA is on, an app
# password instead of the normal account password.
# See: https://aka.ms/smtp_auth_disabled
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp.office365.com
MAIL_PORT=587
MAIL_USERNAME=your-account@yourcompany.com
MAIL_PASSWORD=your-app-password
MAIL_FROM_ADDRESS="your-account@yourcompany.com"
MAIL_FROM_NAME="${APP_NAME}"

# Microsoft Teams auto-generated meetings (optional, not required — meetings work
# fine with a manually pasted link). Requires an Azure AD app registration with
# admin-consented "OnlineMeetings.ReadWrite.All" application permission. See the
# "Microsoft Teams Integration" section of the README before setting these.
# MS_TEAMS_TENANT_ID=
# MS_TEAMS_CLIENT_ID=
# MS_TEAMS_CLIENT_SECRET=
# MS_TEAMS_ORGANIZER_UPN=

# Backups (see the README's "Backups" section). Defaults are sensible for local
# dev — a sibling folder next to the project directory — but review both before
# relying on them in production.
# BACKUP_ARCHIVE_PATH=/absolute/path/outside/the/project/eventflow-backups
# BACKUP_NOTIFICATION_EMAIL=you@yourcompany.com
# BACKUP_ARCHIVE_PASSWORD=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
